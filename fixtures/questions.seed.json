      "updatedAt": "2026-11-04T08:00:00.000Z",
      "schemaVersion": 1,
      "type": "single",
      "options": [
        {
          "id": "a",
          "text": "A → B → C"
        },
        {
          "id": "b",
          "text": "C → B → A"
        },
        {
          "id": "c",
          "text": "C → A → B"
        },
